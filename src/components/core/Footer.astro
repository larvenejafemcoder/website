---
const socials = [
  { label: 'github', href: 'https://github.com/larvenejafemcoder' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/joshua-t-85a9b6228/' },
];
---

<footer id="contact" class="relative border-t border-border-subtle py-20 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <p class="font-mono text-xs text-neon-purple mb-4 tracking-widest">NODE_04 // CONTACT</p>
        <h2 class="text-5xl md:text-7xl font-bold tracking-tight mb-6 text-text-primary">
          Establish<br />
          <span class="text-transparent bg-clip-text bg-gradient-neon">Connection</span>
        </h2>
        <p class="text-text-muted font-mono text-sm mb-8 max-w-md">
          // TRANSMISSION_LINE_OPEN — send a signal through the void
        </p>
        <div class="flex items-center gap-4">
          <span class="text-text-muted font-mono text-sm">{'>'}_</span>
          <a href="mailto:hello@edqe.me" class="font-mono text-lg text-neon-purple hover:text-neon-magenta transition-colors duration-300 relative group">
            hello@edqe.me
            <span class="absolute -bottom-1 left-0 w-0 h-px bg-gradient-neon transition-all duration-300 group-hover:w-full"></span>
          </a>
        </div>
      </div>
      <div class="flex flex-col justify-end items-start md:items-end gap-6">
        <div class="flex gap-6">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noreferrer"
                class="font-mono text-sm text-text-muted hover:text-neon-purple transition-colors duration-300 uppercase tracking-wider"
              >
                [{s.label}]
              </a>
            ))
          }
        </div>
        <p class="font-mono text-xs text-text-muted opacity-50">
          &copy; {new Date().getFullYear()} // ALL_RIGHTS_RESERVED
        </p>
      </div>
    </div>
  </div>
</footer>
