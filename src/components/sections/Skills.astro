---
import { skillCategories } from '../../data/skills';

function getLevelColor(level: number): string {
  if (level >= 85) return 'bg-neon-purple';
  if (level >= 70) return 'bg-neon-violet';
  if (level >= 55) return 'bg-neon-deep';
  return 'bg-text-muted';
}
---

<section id="skills" class="relative w-full min-h-screen py-32 overflow-hidden" style="background: var(--bg-primary);">
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6">
    <p class="font-mono text-xs text-electric-blue mb-4 tracking-widest">NODE_03 // CAPABILITIES</p>
    <h2 class="text-4xl md:text-6xl font-bold tracking-tight mb-16">
      <span class="text-text-primary">Skill</span>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-electric-blue to-cyber-cyan">Constellation</span>
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      {
        skillCategories.map((category) => (
          <div
            key={category.name}
            class="p-6 border border-border-subtle rounded-sm bg-glass-bg backdrop-blur-sm group hover:border-[color:var(--cat-color)] transition-all duration-500"
            style="--cat-color: {category.color}"
          >
            <div class="flex items-center gap-3 mb-6">
              <span
                class="w-2 h-2 rounded-full"
                style="background: {category.color}; box-shadow: 0 0 8px {category.color}"
              ></span>
              <h3 class="font-mono text-sm uppercase tracking-widest" style="color: {category.color}">
                {category.name}
              </h3>
            </div>

            <div class="space-y-4">
              {
                category.skills.map((skill) => (
                  <div key={skill.name} class="group/skill">
                    <div class="flex items-center justify-between mb-1.5">
                      <span class="font-mono text-sm text-text-secondary group-hover/skill:text-text-primary transition-colors duration-300">
                        {skill.name}
                      </span>
                      <span class="font-mono text-xs text-text-muted">{skill.level}%</span>
                    </div>
                    <div class="h-px w-full bg-border-subtle rounded-full overflow-hidden">
                      <div
                        class="h-full rounded-full transition-all duration-1000 ease-expo"
                        style="width: {skill.level}%; background: {category.color}; box-shadow: 0 0 6px {category.color}"
                      ></div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
