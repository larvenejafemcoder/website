---
---

<section class="relative w-full py-32 overflow-hidden border-t border-border-subtle">
  <div class="relative z-10 w-full max-w-3xl mx-auto px-6 text-center">
    <p class="font-mono text-xs text-neon-pink mb-4 tracking-widest">NODE_04 // TRANSMISSION</p>
    <h2 class="text-4xl md:text-7xl font-bold tracking-tight mb-6">
      <span class="text-text-primary">Open</span>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-pink to-bright-magenta">Channel</span>
    </h2>
    <p class="font-mono text-sm text-text-muted mb-12 max-w-lg mx-auto leading-relaxed">
      <span class="text-neon-purple">{'>'}</span> TRANSMISSION_LINE_ESTABLISHED<br />
      <span class="text-neon-purple">{'>'}</span> Waiting for incoming data...
    </p>

    <div class="max-w-xl mx-auto">
      <form
        class="space-y-6 text-left"
        netlify
        name="contact"
        method="POST"
        data-netlify="true"
      >
        <input type="hidden" name="form-name" value="contact" />

        <div class="group relative">
          <label class="block font-mono text-xs text-text-muted mb-2 tracking-wider" for="name">
            <span class="text-neon-purple">></span> NAME_
          </label>
          <input
            type="text"
            name="name"
            id="name"
            required
            placeholder="Enter your handle..."
            class="w-full bg-transparent border border-border-subtle rounded-sm px-4 py-3 font-mono text-sm text-text-primary placeholder-text-muted/40 outline-none transition-all duration-300 focus:border-neon-purple focus:shadow-glow-purple"
          />
        </div>

        <div class="group relative">
          <label class="block font-mono text-xs text-text-muted mb-2 tracking-wider" for="email">
            <span class="text-neon-purple">></span> SIGNAL_ORIGIN_
          </label>
          <input
            type="email"
            name="email"
            id="email"
            required
            placeholder="your@signal.com"
            class="w-full bg-transparent border border-border-subtle rounded-sm px-4 py-3 font-mono text-sm text-text-primary placeholder-text-muted/40 outline-none transition-all duration-300 focus:border-neon-purple focus:shadow-glow-purple"
          />
        </div>

        <div class="group relative">
          <label class="block font-mono text-xs text-text-muted mb-2 tracking-wider" for="message">
            <span class="text-neon-purple">></span> MESSAGE_PAYLOAD_
          </label>
          <textarea
            name="message"
            id="message"
            required
            rows="5"
            placeholder="Transmit your message..."
            class="w-full bg-transparent border border-border-subtle rounded-sm px-4 py-3 font-mono text-sm text-text-primary placeholder-text-muted/40 outline-none transition-all duration-300 focus:border-neon-purple focus:shadow-glow-purple resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="group relative w-full px-8 py-4 font-mono text-sm uppercase tracking-widest text-bg-primary bg-gradient-neon rounded-sm transition-all duration-300 hover:shadow-glow-purple active:scale-[0.98]"
        >
          <span class="relative z-10">Transmit Signal</span>
          <span class="relative z-10 ml-2 group-hover:translate-x-1 inline-block transition-transform">⟫</span>
        </button>
      </form>
    </div>
  </div>
</section>
