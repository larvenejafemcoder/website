---
import '../styles/global.css';
import Scanlines from '../components/core/Scanlines.astro';
import Navigation from '../components/core/Navigation.astro';
import Footer from '../components/core/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { title = 'Neon Sanctuary // Terminal', description = 'Digital neon sanctuary' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05010a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="/icon.png" />
  </head>
  <body class="bg-bg-primary text-text-primary">
    <Scanlines />
    <Navigation />
    <main class="relative z-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
